---
import "@styles/globals.css";
import Header from "@components/Header.jsx";
import CallToActionFloating from "@components/CallToActionFloating.jsx";
import Footer from "@components/Footer.jsx";
import { Toaster } from "@components/ui/toaster.jsx";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  keywords?: string;
  structuredData?: object;
}

const {
  title = "Ángela Cervantes - Música y Arte",
  description = "Música, clases y proyectos artísticos. Descubre mi mundo musical y únete a esta experiencia única.",
  image = "/images/og-image.jpg",
  keywords = "Ángela Cervantes, música, clases de música, proyectos musicales, artista, cantante, jazz, world music, música mediterránea",
  structuredData,
} = Astro.props;

const siteUrl = "https://angelacervant.es"; // Fallback if Astro.site is not set yet
const canonicalURL = new URL(Astro.url.pathname, Astro.site || siteUrl);

const defaultJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Ángela Cervantes",
  url: siteUrl,
  image: `${siteUrl}${image}`,
  jobTitle: "Cantante, Músico, Artista",
  description: description,
  sameAs: [
    "https://www.instagram.com/angelacervantesmusic",
    "https://www.facebook.com/angelacervantesmesa",
    "https://open.spotify.com/artist/...", // Update with actual link if available or remove
  ],
};

const finalJsonLd = structuredData || defaultJsonLd;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="view-transition" content="same-origin" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon and App Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Web App Manifest -->
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Ángela Cervantes" />
    <meta name="keywords" content={keywords} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, siteUrl)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, siteUrl)} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(finalJsonLd)} />

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;600;700;800;900&family=Playfair+Display:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header client:load />
    <main class="min-h-screen">
      <slot />
    </main>
    <Footer client:load />
    <CallToActionFloating client:load />
    <Toaster client:load />
    <Analytics />
  </body>
</html>
